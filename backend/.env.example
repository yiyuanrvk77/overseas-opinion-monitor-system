# 海外舆情监测系统 环境变量示例
# 复制为 .env 后按需填写；缺失/未填的 Key 会降级为本地离线方案，系统仍可运行。

# 向量/大模型 API Key（三选一或多选；缺失自动降级）
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENAI_API_KEY=

# Qwen 对话模型（默认 qwen-plus）
QWEN_CHAT_MODEL=qwen-plus

# 监听地址与端口（systemd 已固定 0.0.0.0:8000，可覆盖）
OPINION_MONITOR_HOST=0.0.0.0
OPINION_MONITOR_PORT=8000

# SQLite 持久化路径（systemd 已固定）
OPINION_MONITOR_DB=/opt/overseas-opinion-monitor/backend/data/opinion_monitor.db

# 轮转日志目录（留空则仅控制台/journald）
OPINION_MONITOR_LOG_DIR=/opt/overseas-opinion-monitor/runtime/logs

# 可选基础认证（留空则关闭）
OPINION_MONITOR_AUTH_USER=
OPINION_MONITOR_AUTH_PASSWORD=
